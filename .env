# Usage to export all at once (in current shell):
#   set -a; source .env; set +a

# -----------------------------
# Core credentials and servers
# -----------------------------
SERVER_PASSWORD="bmwlab"

CN_SERVER_USER="oai-cn"
CN_SERVER_HOST="192.168.8.108"

GNB_SERVER_USER="oai72_su"
GNB_SERVER_HOST="192.168.8.82"

# NFAPI split VNF server (optional; used when mode=NFAPI and not single-machine)
VNF_GNB_SERVER_USER="hpe"
VNF_GNB_SERVER_HOST="192.168.8.26"

# ADB target device (UE)
ADB_DEVICE="R5CN30TMBYR"

# CN egress interface for ping; iperf server IP the UE connects to
INTERFACE="ogstun"
TEST_SERVER_IP="10.45.0.1"

# SSH options (keep quotes due to space)
SSH_OPTIONS="-o StrictHostKeyChecking=no"

# -----------------------------
# Orchestrator mode toggles
# -----------------------------
# Monolithic or NFAPI
CURRENT_MODE="Monolithic"
# NFAPI on single machine (true/false)
SINGLE_MACHINE_MODE=false

# -----------------------------
# Test matrix
# -----------------------------
DL_START=100
DL_END=800
DL_STEP=100

ENABLE_UL=false
UL_START=10
UL_END=120
UL_STEP=10

TEST_UDP=true
TEST_TCP=false

# Duration in seconds
TEST_DURATION=1
SLEEP_WINDOW=5

# -----------------------------
# Optional extras (compat)
# -----------------------------
WAIT_AFTER_REBOOT=60
WAIT_AFTER_GNB=18
MAX_RETRIES=6

# Paths (kept for compatibility; not required by run_analysis.py)
VNF_BASE_PATH=~/OnlyOAI/openairinterface5g
PNF_BASE_PATH=~/oai_mp_e/openairinterface5g
GNB_LOG_FILE=~/ming.log

# Control PC (used by shell utilities; not required by run_analysis.py)
CONTROL_PC_USER="sshuser"
CONTROL_PC_IP="140.118.162.81"
control_pc_iperf_path="C:\\Users\\sshuser\\Desktop\\iperf3"
